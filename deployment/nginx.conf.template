pid /tmp/pluggo-nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 512; }
http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log /dev/stdout;
    client_max_body_size 16k;
    # Compress scripts, styles and the 3D models: the phone downloads about a third of the bytes.
    gzip on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_types application/octet-stream model/gltf-binary application/javascript text/javascript text/css image/svg+xml application/json text/plain;
    server {
        listen __PORT__;
        root /app/frontend;
        index index.html;
        location /api/customer/simulator/ { return 404; }
        location /api/customer/ {
            proxy_pass http://127.0.0.1:18080;
            proxy_set_header Host $http_host;
            proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
            proxy_set_header Connection "";
        }
        location = /api/health { proxy_pass http://127.0.0.1:18080; }
        location = /api/ready { proxy_pass http://127.0.0.1:18080; }
        # Only Vercel's server-side proxy knows this operator gateway credential. The C++ API
        # additionally requires a signed-in operator phone (Authorization: Bearer <Firebase ID token>).
        location ~ ^/api/(operator/(auth|refund)|station|plan|budget|queue(/serve)?|solar/simulate|emergency|chargers/(A1|A2|B1|B2))$ {
            if ($http_x_pluggo_gateway_key != "__GATEWAY_KEY__") { return 401; }
            proxy_pass http://127.0.0.1:18080;
            proxy_set_header Host $http_host;
            proxy_set_header Connection "";
        }
        location /api/ { return 404; }
        # Images and 3D models change rarely (their URLs carry a version), so phones keep them a week.
        location ~* \.(glb|png|webp|jpg|svg)$ { try_files $uri =404; add_header Cache-Control "public, max-age=604800"; }
        location / { try_files $uri $uri/ =404; add_header Cache-Control "no-cache"; }
    }
}
