# Copy to .env next to docker-compose.yml and fill in. Never commit .env.
# The public domain (DNS A record → this VM's public IP). Caddy gets the certificate.
PLUGGO_DOMAIN=pluggo.example.com

# Operator gateway key shared with the Vercel dashboard (32–128 URL-safe characters).
PLUGGO_GATEWAY_KEY=

# Phone sign-in (Firebase) and operator access.
PLUGGO_FIREBASE_PROJECT_ID=
PLUGGO_FIREBASE_API_KEY=
PLUGGO_FIREBASE_APP_ID=
PLUGGO_OPERATOR_PHONES=

# Razorpay (rzp_test_… or live keys) and its webhook secret.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional off-site backup (Litestream). The /data volume already persists on the VM;
# this adds a copy in Cloudflare R2 in case the VM itself is lost.
PLUGGO_BACKUP_URL=
PLUGGO_BACKUP_ENDPOINT=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=

# Physical OCPP 1.6J chargers (docs/ocpp-chargers.md), one line of JSON.
PLUGGO_OCPP_CHARGERS=
